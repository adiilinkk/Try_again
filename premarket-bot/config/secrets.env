# =============================================================
# Premarket Bot - API Keys & Secrets
# IMPORTANT: Never commit real values to version control.
#            Copy this file to secrets.local.env and fill in
#            your actual credentials there.
# =============================================================

# ---------------------------
# Market Data Providers
# ---------------------------
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
POLYGON_IO_API_KEY=your_polygon_io_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
TRADIER_API_KEY=your_tradier_api_key_here
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key_here

# ---------------------------
# News & Sentiment Sources
# ---------------------------
NEWSAPI_API_KEY=your_newsapi_api_key_here
BENZINGA_API_KEY=your_benzinga_api_key_here
SEEKING_ALPHA_API_KEY=your_seeking_alpha_api_key_here

# ---------------------------
# AI / LLM Providers
# ---------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------
# Delivery / Notifications
# ---------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=your_slack_channel_id_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=your_sender_email@example.com
EMAIL_TO=your_recipient_email@example.com

# ---------------------------
# Database
# ---------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/premarket_bot
REDIS_URL=redis://localhost:6379/0

# ---------------------------
# Monitoring & Observability
# ---------------------------
SENTRY_DSN=your_sentry_dsn_here
DATADOG_API_KEY=your_datadog_api_key_here

# ---------------------------
# Broker Integration (optional)
# ---------------------------
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
